    "import cairo\n",
    "from IPython.display import Image, display\n",
    "from math import pi\n",
    "from io import BytesIO\n",
    "\n",
    "DOWNSCALE = 8\n",
    "N_height, N_width = int(np.sqrt(3)/2*12000)//DOWNSCALE, 12000//DOWNSCALE\n",
    "N_height, N_width"
